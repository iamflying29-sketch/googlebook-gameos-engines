diff -ruN glibc-2.44/elf/libc_early_init.c glibc-2.44-gameos/elf/libc_early_init.c
--- glibc-2.44/elf/libc_early_init.c	2026-07-24 13:16:45.000000000 +0000
+++ glibc-2.44-gameos/elf/libc_early_init.c	2026-10-21 10:04:12.083523557 +0000
@@ -24,14 +24,281 @@
 #include <sys/single_threaded.h>
 #include <getrandom-internal.h>
 #include <malloc/malloc-internal.h>
+#include <stdlib.h>
+#include <string.h>
 
 #ifdef SHARED
 _Bool __libc_initial;
 #endif
 
+#if defined __x86_64__ && defined SHARED
+/* GameOS: Android's seccomp filter for apps traps old x86_64 system calls with SIGSYS.  glibc itself no longer makes
+   them, but Wine, games and static code may.  This handler translates each trapped call into its allowed modern
+   form and returns the result, so the program continues.  Calls with no equivalent return -ENOSYS.  Only raw system
+   calls are used here, so the handler is async-signal-safe.  Set GAMEOS_SYSCALL_LOG=1 to log each call number once.  */
+# include <errno.h>
+# include <fcntl.h>
+# include <signal.h>
+# include <sys/time.h>
+# include <sys/ucontext.h>
+# include <time.h>
+# include <sysdep.h>
+
+# define GAMEOS_NR_POLL 7
+# define GAMEOS_NR_LSTAT 6
+# define GAMEOS_NR_ACCESS 21
+# define GAMEOS_NR_PIPE 22
+# define GAMEOS_NR_SELECT 23
+# define GAMEOS_NR_DUP2 33
+# define GAMEOS_NR_PAUSE 34
+# define GAMEOS_NR_ALARM 37
+# define GAMEOS_NR_FORK 57
+# define GAMEOS_NR_RENAME 82
+# define GAMEOS_NR_MKDIR 83
+# define GAMEOS_NR_RMDIR 84
+# define GAMEOS_NR_CREAT 85
+# define GAMEOS_NR_LINK 86
+# define GAMEOS_NR_UNLINK 87
+# define GAMEOS_NR_SYMLINK 88
+# define GAMEOS_NR_CHMOD 90
+# define GAMEOS_NR_CHOWN 92
+# define GAMEOS_NR_LCHOWN 94
+# define GAMEOS_NR_GETPGRP 111
+# define GAMEOS_NR_UTIME 132
+# define GAMEOS_NR_MKNOD 133
+# define GAMEOS_NR_TIME 201
+# define GAMEOS_NR_EPOLL_CREATE 213
+# define GAMEOS_NR_EPOLL_WAIT 232
+# define GAMEOS_NR_UTIMES 235
+# define GAMEOS_NR_INOTIFY_INIT 253
+# define GAMEOS_NR_FUTIMESAT 261
+# define GAMEOS_NR_SIGNALFD 282
+# define GAMEOS_NR_EVENTFD 284
+
+static int gameos_sigsys_log;
+static unsigned char gameos_sigsys_seen[512];
+
+static void
+gameos_sigsys_note (int nr)
+{
+  if (!gameos_sigsys_log || nr < 0 || nr >= 512 || gameos_sigsys_seen[nr]++)
+    return;
+  char buf[48] = "gameos-sigsys: translated or refused call ";
+  char num[12];
+  int n = 0;
+  unsigned int v = nr;
+  do num[n++] = '0' + v % 10; while ((v /= 10) != 0);
+  char out[64];
+  int len = 0;
+  for (int i = 0; buf[i] != 0 && len < 48; i++)
+    out[len++] = buf[i];
+  while (n > 0)
+    out[len++] = num[--n];
+  out[len++] = '\n';
+  INTERNAL_SYSCALL_CALL (write, 2, out, len);
+}
+
+static long int
+gameos_timeval_to_timespec (const struct timeval *tv, struct timespec *ts)
+{
+  ts->tv_sec = tv->tv_sec;
+  ts->tv_nsec = tv->tv_usec * 1000;
+  return 0;
+}
+
+static void
+gameos_sigsys (int sig, siginfo_t *info, void *ctx)
+{
+  ucontext_t *uc = ctx;
+  greg_t *r = uc->uc_mcontext.gregs;
+  long int a0 = r[REG_RDI], a1 = r[REG_RSI], a2 = r[REG_RDX], a3 = r[REG_R10], a4 = r[REG_R8];
+  long int ret = -ENOSYS;
+  int nr = info->si_syscall;
+  switch (nr)
+    {
+    case GAMEOS_NR_ACCESS:
+      ret = INTERNAL_SYSCALL_CALL (faccessat, AT_FDCWD, a0, a1);
+      break;
+    case GAMEOS_NR_MKDIR:
+      ret = INTERNAL_SYSCALL_CALL (mkdirat, AT_FDCWD, a0, a1);
+      break;
+    case GAMEOS_NR_RMDIR:
+      ret = INTERNAL_SYSCALL_CALL (unlinkat, AT_FDCWD, a0, AT_REMOVEDIR);
+      break;
+    case GAMEOS_NR_UNLINK:
+      ret = INTERNAL_SYSCALL_CALL (unlinkat, AT_FDCWD, a0, 0);
+      break;
+    case GAMEOS_NR_RENAME:
+      ret = INTERNAL_SYSCALL_CALL (renameat, AT_FDCWD, a0, AT_FDCWD, a1);
+      break;
+    case GAMEOS_NR_LINK:
+      ret = INTERNAL_SYSCALL_CALL (linkat, AT_FDCWD, a0, AT_FDCWD, a1, 0);
+      break;
+    case GAMEOS_NR_SYMLINK:
+      ret = INTERNAL_SYSCALL_CALL (symlinkat, a0, AT_FDCWD, a1);
+      break;
+    case GAMEOS_NR_CHMOD:
+      ret = INTERNAL_SYSCALL_CALL (fchmodat, AT_FDCWD, a0, a1);
+      break;
+    case GAMEOS_NR_CHOWN:
+      ret = INTERNAL_SYSCALL_CALL (fchownat, AT_FDCWD, a0, a1, a2, 0);
+      break;
+    case GAMEOS_NR_LCHOWN:
+      ret = INTERNAL_SYSCALL_CALL (fchownat, AT_FDCWD, a0, a1, a2, AT_SYMLINK_NOFOLLOW);
+      break;
+    case GAMEOS_NR_CREAT:
+      ret = INTERNAL_SYSCALL_CALL (openat, AT_FDCWD, a0, O_CREAT | O_WRONLY | O_TRUNC, a1);
+      break;
+    case GAMEOS_NR_MKNOD:
+      ret = INTERNAL_SYSCALL_CALL (mknodat, AT_FDCWD, a0, a1, a2);
+      break;
+    case GAMEOS_NR_LSTAT:
+      ret = INTERNAL_SYSCALL_CALL (newfstatat, AT_FDCWD, a0, a1, AT_SYMLINK_NOFOLLOW);
+      break;
+    case GAMEOS_NR_POLL:
+      {
+        struct timespec ts, *tp = NULL;
+        if ((int) a2 >= 0)
+          {
+            ts.tv_sec = (int) a2 / 1000;
+            ts.tv_nsec = ((int) a2 % 1000) * 1000000L;
+            tp = &ts;
+          }
+        ret = INTERNAL_SYSCALL_CALL (ppoll, a0, a1, tp, NULL, 0);
+      }
+      break;
+    case GAMEOS_NR_SELECT:
+      {
+        struct timespec ts, *tp = NULL;
+        struct timeval *tv = (struct timeval *) a4;
+        if (tv != NULL)
+          {
+            gameos_timeval_to_timespec (tv, &ts);
+            tp = &ts;
+          }
+        ret = INTERNAL_SYSCALL_CALL (pselect6, a0, a1, a2, a3, tp, NULL);
+        if (tv != NULL)
+          {
+            tv->tv_sec = ts.tv_sec;
+            tv->tv_usec = ts.tv_nsec / 1000;
+          }
+      }
+      break;
+    case GAMEOS_NR_PIPE:
+      ret = INTERNAL_SYSCALL_CALL (pipe2, a0, 0);
+      break;
+    case GAMEOS_NR_DUP2:
+      if (a0 == a1)
+        {
+          ret = INTERNAL_SYSCALL_CALL (fcntl, a0, F_GETFD);
+          if (ret >= 0)
+            ret = a1;
+        }
+      else
+        ret = INTERNAL_SYSCALL_CALL (dup3, a0, a1, 0);
+      break;
+    case GAMEOS_NR_PAUSE:
+      ret = INTERNAL_SYSCALL_CALL (ppoll, NULL, 0, NULL, NULL, 0);
+      break;
+    case GAMEOS_NR_ALARM:
+      {
+        struct itimerval nv = { { 0, 0 }, { (unsigned int) a0, 0 } }, ov;
+        ret = INTERNAL_SYSCALL_CALL (setitimer, ITIMER_REAL, &nv, &ov);
+        if (ret == 0)
+          ret = ov.it_value.tv_sec + (ov.it_value.tv_usec >= 500000
+                                      || (ov.it_value.tv_sec == 0 && ov.it_value.tv_usec > 0));
+      }
+      break;
+    case GAMEOS_NR_FORK:
+      ret = INTERNAL_SYSCALL_CALL (clone, SIGCHLD, 0, NULL, NULL, 0);
+      break;
+    case GAMEOS_NR_GETPGRP:
+      ret = INTERNAL_SYSCALL_CALL (getpgid, 0);
+      break;
+    case GAMEOS_NR_TIME:
+      {
+        struct timespec ts;
+        ret = INTERNAL_SYSCALL_CALL (clock_gettime, CLOCK_REALTIME, &ts);
+        if (ret == 0)
+          {
+            ret = ts.tv_sec;
+            if (a0 != 0)
+              *(time_t *) a0 = ts.tv_sec;
+          }
+      }
+      break;
+    case GAMEOS_NR_UTIME:
+      {
+        struct timespec ts[2];
+        const long int *ut = (const long int *) a1;
+        if (ut != NULL)
+          {
+            ts[0].tv_sec = ut[0]; ts[0].tv_nsec = 0;
+            ts[1].tv_sec = ut[1]; ts[1].tv_nsec = 0;
+          }
+        ret = INTERNAL_SYSCALL_CALL (utimensat, AT_FDCWD, a0, ut != NULL ? ts : NULL, 0);
+      }
+      break;
+    case GAMEOS_NR_UTIMES:
+    case GAMEOS_NR_FUTIMESAT:
+      {
+        int dirfd = nr == GAMEOS_NR_UTIMES ? AT_FDCWD : (int) a0;
+        long int path = nr == GAMEOS_NR_UTIMES ? a0 : a1;
+        const struct timeval *tv = (const struct timeval *) (nr == GAMEOS_NR_UTIMES ? a1 : a2);
+        struct timespec ts[2];
+        if (tv != NULL)
+          {
+            gameos_timeval_to_timespec (&tv[0], &ts[0]);
+            gameos_timeval_to_timespec (&tv[1], &ts[1]);
+          }
+        ret = INTERNAL_SYSCALL_CALL (utimensat, dirfd, path, tv != NULL ? ts : NULL, 0);
+      }
+      break;
+    case GAMEOS_NR_EPOLL_CREATE:
+      ret = (int) a0 <= 0 ? -EINVAL : INTERNAL_SYSCALL_CALL (epoll_create1, 0);
+      break;
+    case GAMEOS_NR_EPOLL_WAIT:
+      ret = INTERNAL_SYSCALL_CALL (epoll_pwait, a0, a1, a2, a3, NULL, 0);
+      break;
+    case GAMEOS_NR_INOTIFY_INIT:
+      ret = INTERNAL_SYSCALL_CALL (inotify_init1, 0);
+      break;
+    case GAMEOS_NR_SIGNALFD:
+      ret = INTERNAL_SYSCALL_CALL (signalfd4, a0, a1, a2, 0);
+      break;
+    case GAMEOS_NR_EVENTFD:
+      ret = INTERNAL_SYSCALL_CALL (eventfd2, a0, 0);
+      break;
+    default:
+      ret = -ENOSYS;
+      break;
+    }
+  gameos_sigsys_note (nr);
+  r[REG_RAX] = ret;
+}
+
+static void
+gameos_sigsys_install (void)
+{
+  const char *log = getenv ("GAMEOS_SYSCALL_LOG");
+  gameos_sigsys_log = log != NULL && log[0] == '1';
+  struct sigaction sa;
+  memset (&sa, 0, sizeof sa);
+  sa.sa_sigaction = gameos_sigsys;
+  sa.sa_flags = SA_SIGINFO;
+  __sigaction (SIGSYS, &sa, NULL);
+}
+#endif
+
 void
 __libc_early_init (_Bool initial)
 {
+#if defined __x86_64__ && defined SHARED
+  /* GameOS: install the SIGSYS translator before any other start-up work.  */
+  if (initial)
+    gameos_sigsys_install ();
+#endif
+
   /* Initialize ctype data.  */
   __ctype_init ();
 
